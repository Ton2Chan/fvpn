#!/bin/bash
# ==============================================================================
# FVPN - Main Executable Entrypoint
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

# lib ディレクトリ直下の正規 .sh のみ読み込み
for f in ./lib/*.sh; do
    [ -f "$f" ] || continue
    [[ "$f" =~ \( ]] && continue
    source "$f"
done

# ------------------------------------------------------------------------------
# 起動時システム初期化 ＆ メインメニュー実行
# ------------------------------------------------------------------------------

# 1. 物理層のお膳立て
_phy_boot

# 2. 新・状態判定フラグのセットとトラップ表示 (追加部分)
init_boot_process

# 3. メインメニューの呼び出し
show_main_menu "$@"
