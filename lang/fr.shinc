["msg_disconnect_vpn_executing"]="Déconnexion du VPN..."
["msg_disconnect_vpn_restored"]="✓ Trafic IP direct restauré."
["msg_disconnect_vpn_failed"]="❌ Échec de l'arrêt des processus physiques."

