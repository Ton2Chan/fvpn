["msg_configure_protocol_mode_opt1"]="1: UDP uniquement (rapide / recommandé)"
["msg_configure_protocol_mode_opt2"]="2: TCP uniquement (stabilité prioritaire)"
["msg_configure_protocol_mode_opt3"]="3: Mixte (choisir entre UDP et TCP)"
["msg_configure_protocol_mode_prompt"]="Choisir le protocole [1-3] : "

# configure_filter_level
["msg_configure_filter_level_menu"]="--- Sélectionner le niveau de filtre de connexion ---\n 4)  [4] 3  2  1  0  : Sélectionner uniquement les évaluations 4 (favoris)\n 3)  [4  3] 2  1  0  : Sélectionner les évaluations 3 (utilisables) et supérieures\n 2)  [4  3  2] 1  0  : Sélectionner les évaluations 2 (standard / non évaluées) et supérieures\n 1)  [4  3  2  1] 0  : Sélectionner les évaluations 1 (à peine utilisables) et supérieures\n 0)  [4  3  2  1  0] : Sélectionner tous les serveurs\n---------------------------------------------------"
["msg_configure_filter_level_prompt"]="Choisir le niveau [0-4 / Entrée pour revenir] : "

