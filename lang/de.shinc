# German

declare -gA MSG=(
# show_status_header
    ["msg_show_status_header_auth_prefix"]="Authentifizierung:"

# connect_by_master_index_wm
    ["msg_connect_by_master_index_wm_success"]=" ✓ VPN-Verbindung erfolgreich hergestellt."
    ["msg_connect_by_master_index_wm_fail"]=" ❌ VPN-Verbindung fehlgeschlagen."
    ["msg_connect_by_master_index_wm_lockdown"]=" 🔒 Der Datenverkehr wird durch den Kill Switch (LOCKDOWN) geschützt."

# disconnect_vpn
    ["msg_disconnect_vpn_executing"]="VPN wird getrennt..."
    ["msg_disconnect_vpn_restored"]="✓ Direkter IP-Datenverkehr wurde wiederhergestellt."
    ["msg_disconnect_vpn_failed"]="❌ Physische Prozesse konnten nicht gestoppt werden."

# exit_fvpn
    ["msg_exit_fvpn_warn"]="⚠️ VPN ist derzeit verbunden (oder der Schutz-Lock ist aktiv)."
    ["msg_exit_fvpn_confirm"]="VPN trennen und beenden? [y/N]: "
    ["msg_exit_fvpn_keep_lock"]="Der VPN-Schutz (Kill Switch) bleibt aktiv."

# configure_connect_mode
    ["msg_configure_connect_mode_opt1"]="1: Fest (immer mit dem ausgewählten Zielserver verbinden)"
    ["msg_configure_connect_mode_opt2"]="2: Sequenziell (bei jeder Verbindung zum nächsten Server wechseln)"
    ["msg_configure_connect_mode_opt3"]="3: Zufällig (jedes Mal automatisch einen passenden Server auswählen)"
    ["msg_configure_connect_mode_prompt"]="Modus wählen [1-3]: "

# configure_protocol_mode
    ["msg_configure_protocol_mode_opt1"]="1: Nur UDP (schnell / empfohlen)"
    ["msg_configure_protocol_mode_opt2"]="2: Nur TCP (Stabilität zuerst)"
    ["msg_configure_protocol_mode_opt3"]="3: Gemischt (zwischen UDP und TCP wählen)"
    ["msg_configure_protocol_mode_prompt"]="Protokoll wählen [1-3]: "
    ["msg_configure_protocol_mode_invalid"]="⚠️ Ungültige Auswahl. Geben Sie einen Wert von 1 bis 3 ein."

# configure_filter_level
    ["msg_configure_filter_level_menu"]="--- Verbindungsfilterstufe auswählen ---\n 4)  [4] 3  2  1  0  : Nur Bewertung 4 (Favoriten) auswählen\n 3)  [4  3] 2  1  0  : Bewertung 3 (nutzbar) und höher auswählen\n 2)  [4  3  2] 1  0  : Bewertung 2 (Standard / nicht bewertet) und höher auswählen\n 1)  [4  3  2  1] 0  : Bewertung 1 (kaum nutzbar) und höher auswählen\n 0)  [4  3  2  1  0] : Alle Server auswählen\n---------------------------------------------------"
    ["msg_configure_filter_level_prompt"]="Stufe wählen [0-4 / Enter zum Zurückkehren]: "

# update_servers
    ["msg_update_servers_net_error"]="Keine Verbindung zum Netzwerk möglich."
