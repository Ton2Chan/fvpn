# Indonesian

declare -gA MSG=(
# show_status_header
    ["msg_show_status_header_auth_prefix"]="Autentikasi:"

# connect_by_master_index_wm
    ["msg_connect_by_master_index_wm_success"]=" ✓  ✓ Koneksi VPN berhasil dibuat."
    ["msg_connect_by_master_index_wm_fail"]=" ❌  ❌ Koneksi VPN gagal."
    ["msg_connect_by_master_index_wm_lockdown"]=" 🔒  🔒 Lalu lintas dilindungi oleh Kill Switch (LOCKDOWN)."

# disconnect_vpn
    ["msg_disconnect_vpn_executing"]="Memutuskan koneksi VPN..."
    ["msg_disconnect_vpn_restored"]="✓ Lalu lintas IP langsung dipulihkan."
    ["msg_disconnect_vpn_failed"]="❌ Gagal menghentikan proses fisik."

# exit_fvpn
    ["msg_exit_fvpn_warn"]="⚠️ ⚠️ VPN saat ini terhubung (atau kunci perlindungan aktif)."
    ["msg_exit_fvpn_confirm"]="Putuskan VPN dan keluar? [y/N]: "
    ["msg_exit_fvpn_keep_lock"]="Perlindungan VPN (Kill Switch) akan tetap aktif."

# configure_connect_mode
    ["msg_configure_connect_mode_opt1"]="1: Tetap (always hubungkan to the yang dipilih target server)"
    ["msg_configure_connect_mode_opt2"]="2: Berurutan (rotate to the next server on each koneksi)"
    ["msg_configure_connect_mode_opt3"]="3: Acak (automatically select a matching server each time)"
    ["msg_configure_connect_mode_prompt"]="Pilih mode [1-3]: "

# configure_protocol_mode
    ["msg_configure_protocol_mode_opt1"]="1: Hanya UDP (fast / recommended)"
    ["msg_configure_protocol_mode_opt2"]="2: Hanya TCP (stability first)"
    ["msg_configure_protocol_mode_opt3"]="3: Campuran (select from both UDP and TCP)"
    ["msg_configure_protocol_mode_prompt"]="Pilih protokol [1-3]: "
    ["msg_configure_protocol_mode_invalid"]="⚠️ Pilihan tidak valid. Masukkan nilai 1 hingga 3."

# configure_filter_level
    ["msg_configure_filter_level_menu"]="--- Pilih koneksi filter level ---\n 4)  [4] 3  2  1  0  : Pilih penilaian 4 (favorites) only\n 3)  [4  3] 2  1  0  : Pilih penilaian 3 (usable) and above\n 2)  [4  3  2] 1  0  : Pilih penilaian 2 (standard / unrated) and above\n 1)  [4  3  2  1] 0  : Pilih penilaian 1 (barely usable) and above\n 0)  [4  3  2  1  0] : Pilih all server\n---------------------------------------------------"
    ["msg_configure_filter_level_prompt"]="Pilih level [0-4 / Enter untuk kembali]: "

