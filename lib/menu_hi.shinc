#!/bin/bash
# ==============================================================================
# FVPN - Menu & User Interaction Module (Hindi / हिन्दी)
# ==============================================================================

# ------------------------------------------------------------------------------
# Display Menu Footer / Status Header
# ------------------------------------------------------------------------------
show_status_header() {
    local phy_mode
    phy_mode=$(get_phy_mode)

    local m_tag="fix"
    case "${CONNECT_MODE}" in
        2|"2"|"SEQ")    m_tag="seq" ;;
        3|"3"|"RANDOM") m_tag="rnd" ;;
        1|"1"|"FIXED"|*) m_tag="fix" ;;
    esac

    # फिक्स्ड कॉलम फॉरमेटिंग
    local fix_str=" $m_tag "
    local lock_str=" lock "
    local state_str=" off "

    case "$phy_mode" in
        "CONNECTED")
            fix_str="[$m_tag]"
            ;;
        "LOCKDOWN")
            lock_str="[lock]"
            ;;
        "DISCONNECTED"|*)
            state_str="[off]"
            ;;
    esac

    # प्रमाणीकरण स्थिति (Auth Status)
    local auth_status="प्रमाणित:[--]"
    local state="${AUTH_STATE:-0}"

    if [ "$state" -gt 0 ]; then
        auth_status="प्रमाणित:[OK]"
    elif [ "$state" -lt 0 ]; then
        auth_status="प्रमाणित:[NG]"
    else
        auth_status="प्रमाणित:[--]"
    fi

    # हेडर आउटपुट
    printf "VPN %s%s%s %s" "$fix_str" "$lock_str" "$state_str" "$auth_status"
    echo ""

    get_server_info_line

    echo ""
    echo "-------------------------------------------"
}

# ==============================================================================
# Connection Processing with UI Messages
# ==============================================================================

connect_by_master_index_wm() {
    local m_idx="$1"

    connect_by_master_index "$m_idx"
    local res=$?

    # --- कनेक्शन परिणाम संदेश ---
    echo ""
    if [ "$res" -eq 0 ]; then
        echo " ✓ VPN कनेक्शन सफलतापूर्वक स्थापित हो गया।"
    else
        echo " ❌ VPN से कनेक्ट करने में विफल।"
        echo " 🔒 नेटवर्क ट्रैफ़िक Kill Switch (LOCKDOWN) द्वारा सुरक्षित है।"
    fi

    return $res
}

disconnect_vpn() {
    echo "VPN डिस्कनेक्ट हो रहा है..."

    if phy_disconnect; then
        phy_cleanup_if_disconnected
        echo "✓ सीधा IP कनेक्शन बहाल कर दिया गया है।"
        return 0
    else
        echo "❌ भौतिक प्रक्रिया (physical process) को रोकने में विफल।"
        return 1
    fi
}

exit_fvpn() {
    local current_mode
    current_mode=$(get_phy_mode)

    if [ "$current_mode" != "DISCONNECTED" ]; then
        echo ""
        echo "⚠️  VPN वर्तमान में कनेक्टेड है (या फ़िल्टर ब्लॉक है)।"
        read -rp "VPN डिस्कनेक्ट करें और बाहर निकलें? [y/N]: " ans

        case "$ans" in
            [yY]|[yY][eE][sS]|हाँ|हान|हां)
                disconnect_vpn
                ;;
            *)
                echo "VPN सुरक्षा स्थिति (Kill Switch) बनाए रख रहे हैं।"
                ;;
        esac
    else
        phy_cleanup_if_disconnected
    fi
}

# ==============================================================================
# Quick Connection Settings UI & Submenu Functions
# ==============================================================================

configure_connect_mode() {
    local m_opt
    echo
    echo "1: निश्चित (हमेशा चुने गए सर्वर से कनेक्ट करें)"
    echo "2: क्रमिक (हर बार अगले सर्वर पर स्विच करें)"
    echo "3: यादृच्छिक (फ़िल्टर किए गए सर्वरों में से स्वचालित चयन)"
    read -rp "मोड चुनें [1-3]: " m_opt
    case "$m_opt" in
        1|2|3)
            CONNECT_MODE="$m_opt"
            ;;
    esac
}

configure_protocol_mode() {
    local p_opt
    echo
    echo "1: केवल UDP (उच्च गति / अनुशंसित)"
    echo "2: केवल TCP (स्थिरता को प्राथमिकता)"
    echo "3: मिश्रित मोड (UDP और TCP दोनों शामिल हैं)"
    read -rp "प्रोटोकॉल चुनें [1-3]: " p_opt
    case "$p_opt" in
        1) set_protocol_mode 1 ;;
        2) set_protocol_mode -1 ;;
        3) set_protocol_mode 0 ;;
        *) return ;;
    esac

    build_active_servers
    sync_target_index_by_server
}

configure_filter_level() {
    local f_val
    echo
    echo "--- कनेक्शन फ़िल्टर स्तर का चयन करें ---"
    echo " 4)  [4] 3  2  1  0  : केवल रेटिंग 4 (पसंदीदा)"
    echo " 3)  [4  3] 2  1  0  : रेटिंग 3 (अच्छा) और ऊपर"
    echo " 2)  [4  3  2] 1  0  : रेटिंग 2 (सामान्य) और ऊपर"
    echo " 1)  [4  3  2  1] 0  : रेटिंग 1 (संतोषजनक) और ऊपर"
    echo " 0)  [4  3  2  1  0] : सभी सर्वर चुनें"
    echo "---------------------------------------------------"
    read -rp "स्तर चुनें [0-4 / वापस जाने के लिए Enter दबाएं]: " f_val
    if [ -n "$f_val" ] && [[ "$f_val" =~ ^[0-4]$ ]]; then
        FILTER_LEVEL="$f_val"
        build_active_servers
        sync_target_index_by_server
    fi
}

update_servers() {
    local mode="${1:-force}"
    local base_dir="${FVPN_HOME:-.}"
    local data_dir="${FVPN_DATA:-${base_dir}/data}"
    local work_zip="${data_dir}/fastestvpn_ovpn.zip"

    local dl_dir
    dl_dir=$(get_download_dir)
    local local_zip="${dl_dir}/fastestvpn_ovpn.zip"
    local local_bak="${dl_dir}/fastestvpn_ovpn.zip.bak"

    if [ "$HAS_UPDATE_ZIP" -eq 1 ]; then
        mkdir -p "$data_dir"
        cp -f "$local_zip" "$work_zip"
        mv -f "$local_zip" "$local_bak"
        HAS_UPDATE_ZIP=0
    else
        if ! is_network_online || [ "$(get_phy_mode)" = "LOCKDOWN" ]; then
            echo "नेटवर्क से कनेक्ट करना असंभव है।"
            return 1
        fi

        if [ "$mode" = "skip" ]; then
            CURRENT_TIMEOUT="${TIMEOUT_AUTO_UPDATE}"
            if ! should_check_update; then
                return 0
            fi
        else
            CURRENT_TIMEOUT="${TIMEOUT_MANUAL_UPDATE}"
        fi

        local target_url="${CUSTOM_UPDATE_URL:-$OFFICIAL_UPDATE_URL}"

        if ! download_url_to_work_zip "$target_url" "$work_zip"; then
            echo "⚠️ अपडेट फ़ाइल डाउनलोड करने में विफल।"
            return 1
        fi
    fi

    if ! apply_work_zip_package; then
        echo "⚠️ अपडेट पैकेज लागू करने में विफल।"
        return 1
    fi

    local default_mark="${MARK_ADDED:-+}"
    if [ "${FVPN_TOTAL_COUNT}" -eq 0 ]; then
        default_mark="${MARK_NORMAL:-_}"
    fi

    build_master_servers "$default_mark"

    echo "✓ सर्वर सूची सफलतापूर्वक अपडेट की गई।"
    return 0
}

# ==============================================================================
# Export Rating Data
# ==============================================================================
export_server_ratings() {
    local target_dir
    target_dir=$(get_download_dir)

    if [ ! -d "$target_dir" ]; then
        mkdir -p "$target_dir" 2>/dev/null || {
            echo "त्रुटि: लक्षित निर्देशिका ($target_dir) बनाने में विफल।"
            return 1
        }
    fi

    if [ -z "$MASTER_SERVERS_BUFFER" ]; then
        echo "त्रुटि: निर्यात के लिए कोई सर्वर डेटा नहीं है।"
        return 1
    fi

    local export_file="${target_dir}/${FILE_RATINGS_EXPORT_NAME:-fvpn_ratings.txt}"
    local tmp_file
    tmp_file=$(mktemp)

    local buf_len=${#MASTER_SERVERS_BUFFER}
    local offset=0
    local exported_count=0

    while [ "$offset" -lt "$buf_len" ]; do
        local rec="${MASTER_SERVERS_BUFFER:$offset:RECORD_BYTE_SIZE}"
        [ ${#rec} -lt 120 ] && break

        local line="${rec%$'\n'}"
        line="${line%"${line##*[![:space:]]}"}"

        if [ -n "$line" ]; then
            printf "%s\n" "$line" >> "$tmp_file"
            ((exported_count++))
        fi

        offset=$((offset + RECORD_BYTE_SIZE))
    done

    if [ "$exported_count" -gt 0 ]; then
        mv "$tmp_file" "$export_file"
        echo "✓ सफलतापूर्वक $exported_count सर्वर रेटिंग रिकॉर्ड निर्यात किए गए।"
        echo "  स्थान: ${export_file}"
    else
        rm -f "$tmp_file"
        echo "त्रुटि: निर्यात के लिए कोई डेटा नहीं है।"
    fi

    return 0
}

# ==============================================================================
# Import Rating Data
# ==============================================================================
import_server_ratings() {
    local target_dir
    target_dir=$(get_download_dir)

    local import_file="${target_dir}/${FILE_RATINGS_EXPORT_NAME:-fvpn_ratings.txt}"

    if [ ! -f "$import_file" ]; then
        echo "त्रुटि: आयात फ़ाइल नहीं मिली।"
        echo "  पथ जांचें: ${import_file}"
        return 1
    fi

    if [ -z "$MASTER_SERVERS_BUFFER" ]; then
        build_master_servers
    fi

    echo "सर्वर रेटिंग डेटा आयात किया जा रहा है..."

    declare -A import_map
    local loaded_count=0
    local line

    while IFS= read -r line || [ -n "$line" ]; do
        [ ${#line} -lt 14 ] && continue

        local p_type="${line:${OFFSET_PROTO}:${LENGTH_PROTO}}"
        local r_val="${line:${OFFSET_RATING}:${LENGTH_RATING}}"
        local fn="${line:${OFFSET_FNAME}}"
        fn=$(echo "$fn" | xargs)

        if [[ "$p_type" =~ ^[ut]$ ]] && [[ "$r_val" =~ ^[0-4]$ ]] && [ -n "$fn" ]; then
            import_map["${p_type}_${fn}"]="$r_val"
            ((loaded_count++))
        fi
    done < "$import_file"

    if [ "$loaded_count" -eq 0 ]; then
        echo "चेतावनी: आयातित फ़ाइल में कोई वैध डेटा नहीं मिला।"
        return 1
    fi

    local rec_size=${RECORD_BYTE_SIZE}
    local buf_len=${#MASTER_SERVERS_BUFFER}
    local offset=0
    local updated_count=0

    while [ "$offset" -lt "$buf_len" ]; do
        local rec="${MASTER_SERVERS_BUFFER:$offset:$rec_size}"
        [ ${#rec} -lt 120 ] && break

        local p_type="${rec:${OFFSET_PROTO}:${LENGTH_PROTO}}"
        local fn="${rec:${OFFSET_FNAME}}"
        fn=$(echo "$fn" | xargs)

        local key="${p_type}_${fn}"

        if [ -n "${import_map[$key]+exists}" ]; then
            local new_r="${import_map[$key]}"
            local current_r="${rec:${OFFSET_RATING}:${LENGTH_RATING}}"

            if [ "$current_r" != "$new_r" ]; then
                local target_idx=$((offset + ${OFFSET_RATING}))
                MASTER_SERVERS_BUFFER="${MASTER_SERVERS_BUFFER:0:$target_idx}${new_r}${MASTER_SERVERS_BUFFER:$((target_idx + 1))}"
                ((updated_count++))
            fi
        fi

        offset=$((offset + rec_size))
    done

    if [ "$updated_count" -gt 0 ]; then
        build_active_servers
        sync_target_index_by_server
        echo "✓ सफलतापूर्वक $updated_count रेटिंग रिकॉर्ड आयात किए गए।"
    else
        echo "सूचना: डेटा में कोई बदलाव नहीं हुआ।"
    fi

    return 0
}

# ==============================================================================
# Quick Connection Logic
# ==============================================================================

quick_connect() {
    local N="${ACTIVE_TOTAL_COUNT}"

    if [ "$N" -le 0 ]; then
        echo "❌ फ़िल्टर पास करने वाले कोई सर्वर उपलब्ध नहीं हैं।"
        return 1
    fi

    case "${CONNECT_MODE}" in
        2)
            TARGET_INDEX=$(( (TARGET_INDEX + 1) % N ))
            ;;
        3)
            local r=$(( RANDOM % N ))
            [ "$r" -eq "$TARGET_INDEX" ] && r=$(( (r + 1) % N ))
            TARGET_INDEX="$r"
            ;;
        1|*)
            (( TARGET_INDEX < 0 )) && TARGET_INDEX=0
            ;;
    esac
    update_target_server_by_index

    local m_idx
    m_idx=$(get_target_master_index)

    local display_info
    display_info=$(get_server_info_line "$TARGET_INDEX")
    echo "${display_info}"

    connect_by_master_index_wm "$m_idx"
    return $?
}

show_quick_connect_settings() {
    while true; do
        local mode_disp proto_disp filter_disp

        case "${CONNECT_MODE}" in
            1) mode_disp="[1:निश्चित] 2:क्रमिक  3:यादृच्छिक" ;;
            2) mode_disp=" 1:निश्चित [2:क्रमिक] 3:यादृच्छिक" ;;
            3) mode_disp=" 1:निश्चित  2:क्रमिक [3:यादृच्छिक]" ;;
            *) mode_disp="[1:निश्चित] 2:क्रमिक  3:यादृच्छिक" ;;
        esac

        local p="${PROTOCOL_MODE}"
        if (( p > 0 )); then
            proto_disp="[1:UDP]  2:TCP  3:मिश्रित"
        elif (( p < 0 )); then
            proto_disp="1:UDP  [2:TCP]  3:मिश्रित"
        else
            proto_disp="1:UDP  2:TCP  [3:मिश्रित]"
        fi

        case "${FILTER_LEVEL}" in
            4) filter_disp="[4] 3  2  1  0" ;;
            3) filter_disp="[4  3] 2  1  0" ;;
            2) filter_disp="[4  3  2] 1  0" ;;
            1) filter_disp="[4  3  2  1] 0" ;;
            0) filter_disp="[4  3  2  1  0]" ;;
            *) filter_disp="[4  3  2] 1  0" ;;
        esac

        echo
        echo "========== त्वरित कनेक्शन सेटिंग्स =========="
        echo " 1) कनेक्शन मोड बदलें : ${mode_disp}"
        echo " 2) प्रोटोकॉल बदलें    : ${proto_disp}"
        echo " 3) फ़िल्टर स्तर       : ${filter_disp}"
        echo " 0) वापस (Enter दबाएं)"
        echo "----------------------------------------------------"
        read -p "विकल्प चुनें [0]: " q_choice
        q_choice="${q_choice:-0}"

        case "$q_choice" in
            1) configure_connect_mode ;;
            2) configure_protocol_mode ;;
            3) configure_filter_level ;;
            0) break ;;
            *) echo "अमान्य चयन।" ;;
        esac
    done
}

# ==============================================================================
# Server Management & Rating UI
# ==============================================================================

reset_ratings_menu() {
    echo ""
    read -p "सभी रेटिंग को डिफ़ॉल्ट (2) पर रीसेट करें? (y/N): " confirm
    case "$confirm" in
        [yY]|[yY][eE][sS]|हाँ|हान|हां)
            if reset_server_ratings; then
                echo "✓ हो गया। (फ़िल्टर स्तर 0 पर रीसेट किया गया)"
            fi
            ;;
        *)
            echo "ऑपरेशन रद्द कर दिया गया।"
            ;;
    esac
}

manage_protocol_servers() {
    local target_proto="$1"
    local proto_label="UDP"
    [ "$target_proto" = "t" ] && proto_label="TCP"

    local record_size=${RECORD_BYTE_SIZE}
    local udp_cnt="${FVPN_UDP_COUNT}"
    local tcp_cnt="${FVPN_TCP_COUNT}"

    local max_num=$udp_cnt
    if [ "$target_proto" = "t" ]; then
        max_num=$tcp_cnt
    fi

    [ "$max_num" -le 0 ] && { echo "(${proto_label} सर्वर नहीं मिले)"; return 0; }

    echo ""
    echo "========== ${proto_label} सर्वर सूची और सेटिंग्स =========="
    
    local base_index
    base_index=$(get_master_index "$target_proto" 1)
    local start_byte=$(( base_index * record_size ))
    local total_bytes=$(( max_num * record_size ))
    local sub_buf="${MASTER_SERVERS_BUFFER:$start_byte:$total_bytes}"

    printf '%s' "$sub_buf" | sed 's/[[:space:]]*$//'

    echo "=================================================="
    echo " संकेत: 4:पसंदीदा, 2:कोई रेटिंग नहीं, 1:संतोषजनक, 3:अच्छा, 0:बहिष्कृत"
    echo "--------------------------------------------------"

    while true; do
        read -rp "बदलने के लिए सर्वर नंबर चुनें [वापस जाने के लिए Enter या 0]: " num_input

        [ -z "$num_input" ] || [ "$num_input" = "0" ] && break

        if [[ ! "$num_input" =~ ^[1-9][0-9]*$ ]] || [ "$num_input" -gt "$max_num" ]; then
            echo "⚠️ कृपया 1 से ${max_num} के बीच की संख्या दर्ज करें।"
            continue
        fi

        local target_master_idx
        target_master_idx=$(get_master_index "$target_proto" "$num_input")

        echo "$(get_master_server_info_line "$target_master_idx")"
        read -rp "नई रेटिंग दर्ज करें [0-4]: " new_rate
        if [[ ! "$new_rate" =~ ^[0-4]$ ]]; then
            echo "⚠️ कृपया 0 से 4 के बीच की संख्या दर्ज करें।"
            continue
        fi

        update_server_rating_by_master_index "$target_master_idx" "$new_rate"
        echo "$(get_master_server_info_line "$target_master_idx")"
        echo ""
    done
}

select_vpn_server() {
    local target_proto=""

    while true; do
        echo -e "\n========== सीधा सर्वर चयन और कनेक्शन =========="
        echo " 1) UDP"
        echo " 2) TCP"
        echo " 0) वापस (Enter दबाएं)"
        read -rp "चुनें [0-2]: " p_choice

        case "$p_choice" in
            1) target_proto="u"; break ;;
            2) target_proto="t"; break ;;
            0|"") echo "ऑपरेशन रद्द कर दिया गया।"; return 0 ;;
            *) echo "⚠️ अमान्य चयन। 0 से 2 के बीच एक संख्या दर्ज करें।" ;;
        esac
    done

    local target_count=0
    if [ "$target_proto" = "u" ]; then
        target_count="${ACTIVE_UDP_COUNT}"
    else
        target_count="${ACTIVE_TCP_COUNT}"
    fi

    if [ "$target_count" -le 0 ]; then
        echo "⚠️ चुने गए प्रोटोकॉल (${target_proto^^}) के लिए फ़िल्टर पास करने वाला कोई सर्वर नहीं है।"
        return 0
    fi

    echo ""
    echo "--- उपलब्ध सर्वर सूची (${target_proto^^} : ${target_count} आइटम्स) ---"

    local start_offset=0
    [ "$target_proto" = "t" ] && start_offset=$(( ${ACTIVE_UDP_COUNT} * RECORD_BYTE_SIZE ))
    local total_bytes=$(( target_count * RECORD_BYTE_SIZE ))

    local sub_buf="${ACTIVE_SERVERS_BUFFER:$start_offset:$total_bytes}"
    printf '%s\n' "$sub_buf" | sed 's/[[:space:]]*$//'

    local match_target_index=-1
    local target_master_idx=-1
    local s_num=""

    while true; do
        read -rp "कनेक्ट करने के लिए सर्वर नंबर दर्ज करें (वापस जाने के लिए 0): " s_num

        if [ -z "$s_num" ] || [ "$s_num" -eq 0 ] 2>/dev/null; then
            echo "ऑपरेशन रद्द कर दिया गया।"
            return 0
        fi

        if ! [[ "$s_num" =~ ^[1-9][0-9]*$ ]]; then
            echo "⚠️ अमान्य इनपुट। कृपया एक सही संख्या दर्ज करें।"
            continue
        fi

        match_target_index=-1
        target_master_idx=-1
        local i=0

        while [ "$i" -lt "$target_count" ]; do
            local current_offset=$(( start_offset + (i * RECORD_BYTE_SIZE) ))
            local rec="${ACTIVE_SERVERS_BUFFER:$current_offset:RECORD_BYTE_SIZE}"

            local num_str="${rec:$OFFSET_INDEX:$LENGTH_INDEX}"
            num_str=$(echo "$num_str" | xargs)

            if [ "$num_str" -eq "$s_num" ] 2>/dev/null; then
                if [ "$target_proto" = "u" ]; then
                    match_target_index="$i"
                else
                    match_target_index=$(( ${ACTIVE_UDP_COUNT} + i ))
                fi

                local p_type="${rec:$OFFSET_PROTO:$LENGTH_PROTO}"
                target_master_idx=$(get_master_index "$p_type" "$num_str")
                break
            fi
            ((i++))
        done

        if [ "$target_master_idx" -ge 0 ]; then
            break
        fi

        echo "⚠️ सर्वर # [ ${s_num} ] फ़िल्टर की गई ${target_proto^^} सूची में उपलब्ध नहीं है।"
    done

    TARGET_INDEX="$match_target_index"
    update_target_server_by_index

    get_server_info_line
    echo ""
    connect_by_master_index_wm "$target_master_idx"
    return $?
}

show_rating_menu() {
    while true; do
        echo ""
        echo "========== सर्वर प्रबंधन मेनू =========="
        echo " 1) UDP सर्वर सूची और रेटिंग"
        echo " 2) TCP सर्वर सूची और रेटिंग"
        echo " 3) सर्वर रेटिंग निर्यात (Export) करें"
        echo " 4) सर्वर रेटिंग आयात (Import) करें"
        echo " 5) सभी रेटिंग रीसेट करें"
        echo " 6) सर्वर सूची अपडेट करें"
        echo " 7) VPN कनेक्शन टाइमआउट सेटिंग्स"
        echo " 0) वापस (Enter दबाएं)"
        echo "--------------------------------------------------------"
        read -rp "चुनें [0]: " rm_choice
        rm_choice="${rm_choice:-0}"

        case "$rm_choice" in
            1) manage_protocol_servers "u" ;;
            2) manage_protocol_servers "t" ;;
            3) export_server_ratings ;;
            4) import_server_ratings ;;
            5) reset_ratings_menu ;;
            6) update_servers ;;
            7) configure_vpn_timeout ;;
            0) break ;;
            *) echo "अमान्य चयन।" ;;
        esac
    done
}

configure_vpn_timeout() {
    local t_val
    echo
    echo "--- VPN कनेक्शन टाइमआउट सेटिंग्स ---"
    echo " वर्तमान मान: ${TIMEOUT_VPN_CONNECT} सेकंड"
    read -rp "सेकंड में नया टाइमआउट दर्ज करें [1-120 / वापस जाने के लिए Enter]: " t_val
    if [[ "$t_val" =~ ^[0-9]+$ ]] && [ "$t_val" -ge 1 ] && [ "$t_val" -le 120 ]; then
        TIMEOUT_VPN_CONNECT="$t_val"
        save_all_settings
        echo "✓ कनेक्शन टाइमआउट ${TIMEOUT_VPN_CONNECT} सेकंड पर सेट किया गया।"
    fi
}

permission_setup() {
    local data_dir="${FVPN_DATA:-$HOME/VPN/FastestVPN/data}"
    local log_dir="${FVPN_LOGDIR:-$HOME/VPN/FastestVPN/logs}"
    local auth_file="$data_dir/auth.conf"
    local logrotate_conf="/etc/logrotate.d/fvpn"

    echo
    echo "=== प्रारंभिक सेटअप (अनुमतियाँ और प्रमाणीकरण) ==="

    if [ "$DEBUG" = "1" ]; then
        echo "[DEBUG] FVPN_DATA = $data_dir"
        echo "[DEBUG] FVPN_LOGDIR = $log_dir"
        echo "[DEBUG] AUTH_FILE = $auth_file"
    fi

    echo "1. निर्देशिकाएँ और अनुमतियाँ सेट कर रहे हैं..."
    if [ ! -d "$data_dir" ]; then
        mkdir -p "$data_dir"
        echo "   ✓ डेटा निर्देशिका बनाई गई: $data_dir"
    fi
    chmod 700 "$data_dir" 2>/dev/null

    if [ ! -d "$log_dir" ]; then
        mkdir -p "$log_dir"
        echo "   ✓ लॉग निर्देशिका बनाई गई: $log_dir"
    fi
    chmod 755 "$log_dir" 2>/dev/null

    echo
    echo "1.5. सिस्टम logrotate सेट कर रहे हैं..."
    
    local abs_log_path
    abs_log_path=$(readlink -f "${log_dir}/openvpn.log")

    cat << EOF | sudo tee "$logrotate_conf" >/dev/null
$abs_log_path {
    size 2M
    rotate 1
    copytruncate
    missingok
    notifempty
    su root root
}
EOF

    if [ $? -eq 0 ]; then
        sudo chmod 644 "$logrotate_conf" 2>/dev/null
        echo "   ✓ logrotate कॉन्फ़िगरेशन लागू किया गया: $logrotate_conf"
    else
        echo "   ⚠️ logrotate लागू करने में विफल (sudo अनुमतियों की जांच करें)"
    fi

    echo
    echo "2. लॉगिन साख (यूज़रनाम/पासवर्ड) सेट करें"

    local current_user=""
    local current_pass=""

    if [ -f "$auth_file" ]; then
        current_user=$(sed -n '1p' "$auth_file")
        current_pass=$(sed -n '2p' "$auth_file")
        echo "   (वर्तमान यूज़र: ${current_user:-सेट नहीं है})"
        echo "   * वर्तमान मान रखने के लिए Enter दबाएं।"
    fi

    echo
    read -rp "यूज़रनाम [${current_user:-सेट नहीं है}]: " input_user
    read -s -rp "पासवर्ड: " input_pass
    echo

    local final_user="${input_user:-$current_user}"
    local final_pass="${input_pass:-$current_pass}"

    if [ -z "$final_user" ] || [ -z "$final_pass" ]; then
        echo "त्रुटि: यूज़रनाम या पासवर्ड खाली है। सहेजना रद्द कर दिया गया।"
        return 1
    fi

    {
        echo "$final_user"
        echo "$final_pass"
    } > "$auth_file"

    chmod 600 "$auth_file"

    echo "✓ साख (Credentials) सहेजे गए: $auth_file"
    echo "प्रारंभिक सेटअप सफलतापूर्वक पूरा हुआ।"
    return 0
}

permission_cleanup() {
    local data_dir="${FVPN_DATA:-$HOME/VPN/FastestVPN/data}"
    local pid_file="$data_dir/fvpn.pid"
    local auth_file="$data_dir/auth.conf"
    local logrotate_conf="/etc/logrotate.d/fvpn"

    echo
    echo "=== सफाई और रीसेट ==="

    if [ "$DEBUG" = "1" ]; then
        echo "[DEBUG] PID_FILE = $pid_file"
        echo "[DEBUG] AUTH_FILE = $auth_file"
    fi

    local cleaned=0

    if [ -f "$pid_file" ]; then
        local pid
        pid=$(cat "$pid_file" 2>/dev/null)
        rm -f "$pid_file"
        echo "✓ शेष PID फ़ाइल हटाई गई (PID: ${pid:-अज्ञात})"
        cleaned=1
    fi

    if [ -f "$logrotate_conf" ]; then
        sudo rm -f "$logrotate_conf" 2>/dev/null
        echo "✓ logrotate कॉन्फ़िगरेशन फ़ाइल हटाई गई: $logrotate_conf"
        cleaned=1
    fi

    if [ "$cleaned" -eq 0 ]; then
        echo "✓ सफाई के लिए कोई शेष फ़ाइलें नहीं मिलीं।"
    fi

    echo "सफाई प्रक्रिया पूरी हुई।"
    return 0
}

show_setup_cleanup_menu() {
    while true; do
        echo ""
        echo "========== सेटअप और सफाई मेनू =========="
        echo " 1) प्रारंभिक सेटअप (अनुमतियाँ और प्रमाणीकरण)"
        echo " 2) सफाई और रीसेट"
        echo " 0) वापस (Enter दबाएं)"
        echo "--------------------------------------------------------------"
        read -rp "चुनें [0]: " sc_choice
        sc_choice="${sc_choice:-0}"

        case "$sc_choice" in
            1) permission_setup ;;
            2) permission_cleanup ;;
            0) break ;;
            *) echo "अमान्य चयन।" ;;
        esac
    done
}

# ==============================================================================
# Main Menu Display
# ==============================================================================
show_main_menu() {
    while true; do
        show_debug_registers

        echo "========== Ton2Chan द्वारा FVPN v1.1.0 =========="
        echo " 1) त्वरित VPN कनेक्शन (लक्ष्य सर्वर से)"
        echo " 2) VPN डिस्कनेक्ट करें"
        echo " 3) सर्वर चुनें और कनेक्ट करें"
        echo " 4) कनेक्शन सेटिंग्स (मोड, प्रोटोकॉल, फ़िल्टर)"
        echo " 5) सर्वर प्रबंधन, रेटिंग और अपडेट"
        echo " 9) सेटअप और सफाई (अनुमतियाँ और प्रमाणीकरण)"
        echo " 0) बाहर निकलें (Exit)"
        echo "-------------------------------------------"
        show_status_header
        
        read -rp "विकल्प चुनें [0-9]: " choice

        case "$choice" in
            1) quick_connect ;;
            2) disconnect_vpn ;;
            3) select_vpn_server ;;
            4) show_quick_connect_settings ;;
            5) show_rating_menu ;;
            9) show_setup_cleanup_menu ;;
            0)
                exit_fvpn
                save_master_servers_buffer
                save_all_settings
                echo "FVPN बंद हो रहा है।"
                break
                ;;
            *) echo "❌ अमान्य चयन।" ;;
        esac

        echo ""
    done
}
