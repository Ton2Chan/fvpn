#!/bin/bash
# ==============================================================================
# FVPN - Menu & User Interaction Module (Russian / Русский)
# ==============================================================================

# ------------------------------------------------------------------------------
# Display Menu Footer / Status Header
# ------------------------------------------------------------------------------
show_status_header() {
    local phy_mode
    phy_mode=$(get_phy_mode)

    local m_tag="fix"
    case "${CONNECT_MODE}" in
        2|"2"|"SEQ")    m_tag="seq" ;;
        3|"3"|"RANDOM") m_tag="rnd" ;;
        1|"1"|"FIXED"|*) m_tag="fix" ;;
    esac

    # Форматирование фиксированных столбцов
    local fix_str=" $m_tag "
    local lock_str=" lock "
    local state_str=" off "

    case "$phy_mode" in
        "CONNECTED")
            fix_str="[$m_tag]"
            ;;
        "LOCKDOWN")
            lock_str="[lock]"
            ;;
        "DISCONNECTED"|*)
            state_str="[off]"
            ;;
    esac

    # Статус аутентификации
    local auth_status="Аутент:[--]"
    local state="${AUTH_STATE:-0}"

    if [ "$state" -gt 0 ]; then
        auth_status="Аутент:[OK]"
    elif [ "$state" -lt 0 ]; then
        auth_status="Аутент:[NG]"
    else
        auth_status="Аутент:[--]"
    fi

    # Вывод заголовка
    printf "VPN %s%s%s %s" "$fix_str" "$lock_str" "$state_str" "$auth_status"
    echo ""

    get_server_info_line

    echo ""
    echo "-------------------------------------------"
}

# ==============================================================================
# Connection Processing with UI Messages
# ==============================================================================

connect_by_master_index_wm() {
    local m_idx="$1"

    connect_by_master_index "$m_idx"
    local res=$?

    # --- Сообщения о результатах подключения ---
    echo ""
    if [ "$res" -eq 0 ]; then
        echo " ✓ VPN-подключение успешно установлено."
    else
        echo " ❌ Ошибка подключения к VPN."
        echo " 🔒 Сетевой трафик защищен с помощью Kill Switch (LOCKDOWN)"
    fi

    return $res
}

disconnect_vpn() {
    echo "Отключение от VPN..."

    if phy_disconnect; then
        phy_cleanup_if_disconnected
        echo "✓ Прямое IP-подключение восстановлено."
        return 0
    else
        echo "❌ Не удалось остановить физический процесс."
        return 1
    fi
}

exit_fvpn() {
    local current_mode
    current_mode=$(get_phy_mode)

    if [ "$current_mode" != "DISCONNECTED" ]; then
        echo ""
        echo "⚠️  VPN в настоящее время подключен (или трафик заблокирован)."
        read -rp "Отключить VPN и выйти? [y/N]: " ans

        case "$ans" in
            [yY]|[yY][eE][sS]|да|Да|ДА)
                disconnect_vpn
                ;;
            *)
                echo "Сохранение состояния защиты VPN (Kill Switch)."
                ;;
        esac
    else
        phy_cleanup_if_disconnected
    fi
}

# ==============================================================================
# Quick Connection Settings UI & Submenu Functions
# ==============================================================================

configure_connect_mode() {
    local m_opt
    echo
    echo "1: Фиксированный (всегда подключаться к выбранному серверу)"
    echo "2: Последовательный (переключаться на следующий сервер при каждом подключении)"
    echo "3: Случайный (автоматический выбор из отфильтрованных серверов)"
    read -rp "Выберите режим [1-3]: " m_opt
    case "$m_opt" in
        1|2|3)
            CONNECT_MODE="$m_opt"
            ;;
    esac
}

configure_protocol_mode() {
    local p_opt
    echo
    echo "1: Только UDP (высокая скорость / рекомендуется)"
    echo "2: Только TCP (приоритет стабильности)"
    echo "3: Смешанный режим (включает UDP и TCP)"
    read -rp "Выберите протокол [1-3]: " p_opt
    case "$p_opt" in
        1) set_protocol_mode 1 ;;
        2) set_protocol_mode -1 ;;
        3) set_protocol_mode 0 ;;
        *) return ;;
    esac

    build_active_servers
    sync_target_index_by_server
}

configure_filter_level() {
    local f_val
    echo
    echo "--- Выбор уровня фильтрации подключений ---"
    echo " 4)  [4] 3  2  1  0  : Только рейтинг 4 (Избранное)"
    echo " 3)  [4  3] 2  1  0  : Рейтинг 3 (Хорошо) и выше"
    echo " 2)  [4  3  2] 1  0  : Рейтинг 2 (Нормально) и выше"
    echo " 1)  [4  3  2  1] 0  : Рейтинг 1 (Удовлетворительно) и выше"
    echo " 0)  [4  3  2  1  0] : Выбрать все сервера"
    echo "---------------------------------------------------"
    read -rp "Выберите уровень [0-4 / Enter для возврата]: " f_val
    if [ -n "$f_val" ] && [[ "$f_val" =~ ^[0-4]$ ]]; then
        FILTER_LEVEL="$f_val"
        build_active_servers
        sync_target_index_by_server
    fi
}

update_servers() {
    local mode="${1:-force}"
    local base_dir="${FVPN_HOME:-.}"
    local data_dir="${FVPN_DATA:-${base_dir}/data}"
    local work_zip="${data_dir}/fastestvpn_ovpn.zip"

    local dl_dir
    dl_dir=$(get_download_dir)
    local local_zip="${dl_dir}/fastestvpn_ovpn.zip"
    local local_bak="${dl_dir}/fastestvpn_ovpn.zip.bak"

    if [ "$HAS_UPDATE_ZIP" -eq 1 ]; then
        mkdir -p "$data_dir"
        cp -f "$local_zip" "$work_zip"
        mv -f "$local_zip" "$local_bak"
        HAS_UPDATE_ZIP=0
    else
        if ! is_network_online || [ "$(get_phy_mode)" = "LOCKDOWN" ]; then
            echo "Невозможно подключиться к сети."
            return 1
        fi

        if [ "$mode" = "skip" ]; then
            CURRENT_TIMEOUT="${TIMEOUT_AUTO_UPDATE}"
            if ! should_check_update; then
                return 0
            fi
        else
            CURRENT_TIMEOUT="${TIMEOUT_MANUAL_UPDATE}"
        fi

        local target_url="${CUSTOM_UPDATE_URL:-$OFFICIAL_UPDATE_URL}"

        if ! download_url_to_work_zip "$target_url" "$work_zip"; then
            echo "⚠️ Не удалось скачать файл обновления."
            return 1
        fi
    fi

    if ! apply_work_zip_package; then
        echo "⚠️ Не удалось применить пакет обновлений."
        return 1
    fi

    local default_mark="${MARK_ADDED:-+}"
    if [ "${FVPN_TOTAL_COUNT}" -eq 0 ]; then
        default_mark="${MARK_NORMAL:-_}"
    fi

    build_master_servers "$default_mark"

    echo "✓ Список серверов успешно обновлен."
    return 0
}

# ==============================================================================
# Export Rating Data
# ==============================================================================
export_server_ratings() {
    local target_dir
    target_dir=$(get_download_dir)

    if [ ! -d "$target_dir" ]; then
        mkdir -p "$target_dir" 2>/dev/null || {
            echo "Ошибка: Не удалось создать целевой каталог ($target_dir)."
            return 1
        }
    fi

    if [ -z "$MASTER_SERVERS_BUFFER" ]; then
        echo "Ошибка: Нет данных серверов для экспорта."
        return 1
    fi

    local export_file="${target_dir}/${FILE_RATINGS_EXPORT_NAME:-fvpn_ratings.txt}"
    local tmp_file
    tmp_file=$(mktemp)

    local buf_len=${#MASTER_SERVERS_BUFFER}
    local offset=0
    local exported_count=0

    while [ "$offset" -lt "$buf_len" ]; do
        local rec="${MASTER_SERVERS_BUFFER:$offset:RECORD_BYTE_SIZE}"
        [ ${#rec} -lt 120 ] && break

        local line="${rec%$'\n'}"
        line="${line%"${line##*[![:space:]]}"}"

        if [ -n "$line" ]; then
            printf "%s\n" "$line" >> "$tmp_file"
            ((exported_count++))
        fi

        offset=$((offset + RECORD_BYTE_SIZE))
    done

    if [ "$exported_count" -gt 0 ]; then
        mv "$tmp_file" "$export_file"
        echo "✓ Успешно экспортировано $exported_count записей рейтинга серверов."
        echo "  Расположение: ${export_file}"
    else
        rm -f "$tmp_file"
        echo "Ошибка: Нет данных для экспорта."
    fi

    return 0
}

# ==============================================================================
# Import Rating Data
# ==============================================================================
import_server_ratings() {
    local target_dir
    target_dir=$(get_download_dir)

    local import_file="${target_dir}/${FILE_RATINGS_EXPORT_NAME:-fvpn_ratings.txt}"

    if [ ! -f "$import_file" ]; then
        echo "Ошибка: Файл импорта не найден."
        echo "  Проверьте путь: ${import_file}"
        return 1
    fi

    if [ -z "$MASTER_SERVERS_BUFFER" ]; then
        build_master_servers
    fi

    echo "Импорт данных рейтинга серверов..."

    declare -A import_map
    local loaded_count=0
    local line

    while IFS= read -r line || [ -n "$line" ]; do
        [ ${#line} -lt 14 ] && continue

        local p_type="${line:${OFFSET_PROTO}:${LENGTH_PROTO}}"
        local r_val="${line:${OFFSET_RATING}:${LENGTH_RATING}}"
        local fn="${line:${OFFSET_FNAME}}"
        fn=$(echo "$fn" | xargs)

        if [[ "$p_type" =~ ^[ut]$ ]] && [[ "$r_val" =~ ^[0-4]$ ]] && [ -n "$fn" ]; then
            import_map["${p_type}_${fn}"]="$r_val"
            ((loaded_count++))
        fi
    done < "$import_file"

    if [ "$loaded_count" -eq 0 ]; then
        echo "Предупреждение: В импортируемом файле не найдено корректных данных."
        return 1
    fi

    local rec_size=${RECORD_BYTE_SIZE}
    local buf_len=${#MASTER_SERVERS_BUFFER}
    local offset=0
    local updated_count=0

    while [ "$offset" -lt "$buf_len" ]; do
        local rec="${MASTER_SERVERS_BUFFER:$offset:$rec_size}"
        [ ${#rec} -lt 120 ] && break

        local p_type="${rec:${OFFSET_PROTO}:${LENGTH_PROTO}}"
        local fn="${rec:${OFFSET_FNAME}}"
        fn=$(echo "$fn" | xargs)

        local key="${p_type}_${fn}"

        if [ -n "${import_map[$key]+exists}" ]; then
            local new_r="${import_map[$key]}"
            local current_r="${rec:${OFFSET_RATING}:${LENGTH_RATING}}"

            if [ "$current_r" != "$new_r" ]; then
                local target_idx=$((offset + ${OFFSET_RATING}))
                MASTER_SERVERS_BUFFER="${MASTER_SERVERS_BUFFER:0:$target_idx}${new_r}${MASTER_SERVERS_BUFFER:$((target_idx + 1))}"
                ((updated_count++))
            fi
        fi

        offset=$((offset + rec_size))
    done

    if [ "$updated_count" -gt 0 ]; then
        build_active_servers
        sync_target_index_by_server
        echo "✓ Успешно импортировано $updated_count записей рейтинга."
    else
        echo "Информация: Данные не изменились."
    fi

    return 0
}

# ==============================================================================
# Quick Connection Logic
# ==============================================================================

quick_connect() {
    local N="${ACTIVE_TOTAL_COUNT}"

    if [ "$N" -le 0 ]; then
        echo "❌ Нет доступных серверов, прошедших фильтрацию."
        return 1
    fi

    case "${CONNECT_MODE}" in
        2)
            TARGET_INDEX=$(( (TARGET_INDEX + 1) % N ))
            ;;
        3)
            local r=$(( RANDOM % N ))
            [ "$r" -eq "$TARGET_INDEX" ] && r=$(( (r + 1) % N ))
            TARGET_INDEX="$r"
            ;;
        1|*)
            (( TARGET_INDEX < 0 )) && TARGET_INDEX=0
            ;;
    esac
    update_target_server_by_index

    local m_idx
    m_idx=$(get_target_master_index)

    local display_info
    display_info=$(get_server_info_line "$TARGET_INDEX")
    echo "${display_info}"

    connect_by_master_index_wm "$m_idx"
    return $?
}

show_quick_connect_settings() {
    while true; do
        local mode_disp proto_disp filter_disp

        case "${CONNECT_MODE}" in
            1) mode_disp="[1:Фикс] 2:Последоват  3:Случайный" ;;
            2) mode_disp=" 1:Фикс [2:Последоват] 3:Случайный" ;;
            3) mode_disp=" 1:Фикс  2:Последоват [3:Случайный]" ;;
            *) mode_disp="[1:Фикс] 2:Последоват  3:Случайный" ;;
        esac

        local p="${PROTOCOL_MODE}"
        if (( p > 0 )); then
            proto_disp="[1:UDP]  2:TCP  3:Смешанный"
        elif (( p < 0 )); then
            proto_disp="1:UDP  [2:TCP]  3:Смешанный"
        else
            proto_disp="1:UDP  2:TCP  [3:Смешанный]"
        fi

        case "${FILTER_LEVEL}" in
            4) filter_disp="[4] 3  2  1  0" ;;
            3) filter_disp="[4  3] 2  1  0" ;;
            2) filter_disp="[4  3  2] 1  0" ;;
            1) filter_disp="[4  3  2  1] 0" ;;
            0) filter_disp="[4  3  2  1  0]" ;;
            *) filter_disp="[4  3  2] 1  0" ;;
        esac

        echo
        echo "========== Настройки быстрого подключения =========="
        echo " 1) Изменить режим подключения : ${mode_disp}"
        echo " 2) Изменить протокол          : ${proto_disp}"
        echo " 3) Уровень фильтрации        : ${filter_disp}"
        echo " 0) Назад (нажмите Enter)"
        echo "----------------------------------------------------"
        read -p "Выберите вариант [0]: " q_choice
        q_choice="${q_choice:-0}"

        case "$q_choice" in
            1) configure_connect_mode ;;
            2) configure_protocol_mode ;;
            3) configure_filter_level ;;
            0) break ;;
            *) echo "Неверный выбор." ;;
        esac
    done
}

# ==============================================================================
# Server Management & Rating UI
# ==============================================================================

reset_ratings_menu() {
    echo ""
    read -p "Сбросить все рейтинги до значения по умолчанию (2)? (y/N): " confirm
    case "$confirm" in
        [yY]|[yY][eE][sS]|да|Да|ДА)
            if reset_server_ratings; then
                echo "✓ Готово. (Уровень фильтрации сброшен на 0)"
            fi
            ;;
        *)
            echo "Операция отменена."
            ;;
    esac
}

manage_protocol_servers() {
    local target_proto="$1"
    local proto_label="UDP"
    [ "$target_proto" = "t" ] && proto_label="TCP"

    local record_size=${RECORD_BYTE_SIZE}
    local udp_cnt="${FVPN_UDP_COUNT}"
    local tcp_cnt="${FVPN_TCP_COUNT}"

    local max_num=$udp_cnt
    if [ "$target_proto" = "t" ]; then
        max_num=$tcp_cnt
    fi

    [ "$max_num" -le 0 ] && { echo "(Сервера ${proto_label} не найдены)"; return 0; }

    echo ""
    echo "========== Список и настройки серверов ${proto_label} =========="
    
    local base_index
    base_index=$(get_master_index "$target_proto" 1)
    local start_byte=$(( base_index * record_size ))
    local total_bytes=$(( max_num * record_size ))
    local sub_buf="${MASTER_SERVERS_BUFFER:$start_byte:$total_bytes}"

    printf '%s' "$sub_buf" | sed 's/[[:space:]]*$//'

    echo "=================================================="
    echo " Обозначения: 4:Избранное, 2:Без оценки, 1:Удовлетворительно, 3:Хорошо, 0:Исключен"
    echo "--------------------------------------------------"

    while true; do
        read -rp "Выберите номер сервера для изменения [Enter или 0 для возврата]: " num_input

        [ -z "$num_input" ] || [ "$num_input" = "0" ] && break

        if [[ ! "$num_input" =~ ^[1-9][0-9]*$ ]] || [ "$num_input" -gt "$max_num" ]; then
            echo "⚠️ Введите число от 1 до ${max_num}."
            continue
        fi

        local target_master_idx
        target_master_idx=$(get_master_index "$target_proto" "$num_input")

        echo "$(get_master_server_info_line "$target_master_idx")"
        read -rp "Введите новый рейтинг [0-4]: " new_rate
        if [[ ! "$new_rate" =~ ^[0-4]$ ]]; then
            echo "⚠️ Введите число от 0 до 4."
            continue
        fi

        update_server_rating_by_master_index "$target_master_idx" "$new_rate"
        echo "$(get_master_server_info_line "$target_master_idx")"
        echo ""
    done
}

select_vpn_server() {
    local target_proto=""

    while true; do
        echo -e "\n========== Прямой выбор сервера и подключение =========="
        echo " 1) UDP"
        echo " 2) TCP"
        echo " 0) Назад (нажмите Enter)"
        read -rp "Выберите [0-2]: " p_choice

        case "$p_choice" in
            1) target_proto="u"; break ;;
            2) target_proto="t"; break ;;
            0|"") echo "Операция отменена."; return 0 ;;
            *) echo "⚠️ Неверный выбор. Введите число от 0 до 2." ;;
        esac
    done

    local target_count=0
    if [ "$target_proto" = "u" ]; then
        target_count="${ACTIVE_UDP_COUNT}"
    else
        target_count="${ACTIVE_TCP_COUNT}"
    fi

    if [ "$target_count" -le 0 ]; then
        echo "⚠️ Нет серверов, прошедших фильтр для выбранного протокола (${target_proto^^})."
        return 0
    fi

    echo ""
    echo "--- Список доступных серверов (${target_proto^^} : ${target_count} элементов) ---"

    local start_offset=0
    [ "$target_proto" = "t" ] && start_offset=$(( ${ACTIVE_UDP_COUNT} * RECORD_BYTE_SIZE ))
    local total_bytes=$(( target_count * RECORD_BYTE_SIZE ))

    local sub_buf="${ACTIVE_SERVERS_BUFFER:$start_offset:$total_bytes}"
    printf '%s\n' "$sub_buf" | sed 's/[[:space:]]*$//'

    local match_target_index=-1
    local target_master_idx=-1
    local s_num=""

    while true; do
        read -rp "Введите номер сервера для подключения (0 для возврата): " s_num

        if [ -z "$s_num" ] || [ "$s_num" -eq 0 ] 2>/dev/null; then
            echo "Операция отменена."
            return 0
        fi

        if ! [[ "$s_num" =~ ^[1-9][0-9]*$ ]]; then
            echo "⚠️ Неверный ввод. Пожалуйста, введите корректный номер."
            continue
        fi

        match_target_index=-1
        target_master_idx=-1
        local i=0

        while [ "$i" -lt "$target_count" ]; do
            local current_offset=$(( start_offset + (i * RECORD_BYTE_SIZE) ))
            local rec="${ACTIVE_SERVERS_BUFFER:$current_offset:RECORD_BYTE_SIZE}"

            local num_str="${rec:$OFFSET_INDEX:$LENGTH_INDEX}"
            num_str=$(echo "$num_str" | xargs)

            if [ "$num_str" -eq "$s_num" ] 2>/dev/null; then
                if [ "$target_proto" = "u" ]; then
                    match_target_index="$i"
                else
                    match_target_index=$(( ${ACTIVE_UDP_COUNT} + i ))
                fi

                local p_type="${rec:$OFFSET_PROTO:$LENGTH_PROTO}"
                target_master_idx=$(get_master_index "$p_type" "$num_str")
                break
            fi
            ((i++))
        done

        if [ "$target_master_idx" -ge 0 ]; then
            break
        fi

        echo "⚠️ Сервер № [ ${s_num} ] недоступен в отфильтрованном списке ${target_proto^^}."
    done

    TARGET_INDEX="$match_target_index"
    update_target_server_by_index

    get_server_info_line
    echo ""
    connect_by_master_index_wm "$target_master_idx"
    return $?
}

show_rating_menu() {
    while true; do
        echo ""
        echo "========== Меню управления серверами =========="
        echo " 1) Список и рейтинг серверов UDP"
        echo " 2) Список и рейтинг серверов TCP"
        echo " 3) Экспорт рейтингов серверов"
        echo " 4) Импорт рейтингов серверов"
        echo " 5) Сбросить все рейтинги"
        echo " 6) Обновить список серверов"
        echo " 7) Настройка таймаута подключения VPN"
        echo " 0) Назад (нажмите Enter)"
        echo "--------------------------------------------------------"
        read -rp "Выберите [0]: " rm_choice
        rm_choice="${rm_choice:-0}"

        case "$rm_choice" in
            1) manage_protocol_servers "u" ;;
            2) manage_protocol_servers "t" ;;
            3) export_server_ratings ;;
            4) import_server_ratings ;;
            5) reset_ratings_menu ;;
            6) update_servers ;;
            7) configure_vpn_timeout ;;
            0) break ;;
            *) echo "Неверный выбор." ;;
        esac
    done
}

configure_vpn_timeout() {
    local t_val
    echo
    echo "--- Настройка таймаута подключения VPN ---"
    echo " Текущее значение: ${TIMEOUT_VPN_CONNECT} сек"
    read -rp "Введите новый таймаут в секундах [1-120 / Enter для возврата]: " t_val
    if [[ "$t_val" =~ ^[0-9]+$ ]] && [ "$t_val" -ge 1 ] && [ "$t_val" -le 120 ]; then
        TIMEOUT_VPN_CONNECT="$t_val"
        save_all_settings
        echo "✓ Таймаут подключения установлен на ${TIMEOUT_VPN_CONNECT} сек."
    fi
}

permission_setup() {
    local data_dir="${FVPN_DATA:-$HOME/VPN/FastestVPN/data}"
    local log_dir="${FVPN_LOGDIR:-$HOME/VPN/FastestVPN/logs}"
    local auth_file="$data_dir/auth.conf"
    local logrotate_conf="/etc/logrotate.d/fvpn"

    echo
    echo "=== Первоначальная настройка (Права и Аутентификация) ==="

    if [ "$DEBUG" = "1" ]; then
        echo "[DEBUG] FVPN_DATA = $data_dir"
        echo "[DEBUG] FVPN_LOGDIR = $log_dir"
        echo "[DEBUG] AUTH_FILE = $auth_file"
    fi

    echo "1. Настройка каталогов и прав доступа..."
    if [ ! -d "$data_dir" ]; then
        mkdir -p "$data_dir"
        echo "   ✓ Создан каталог данных: $data_dir"
    fi
    chmod 700 "$data_dir" 2>/dev/null

    if [ ! -d "$log_dir" ]; then
        mkdir -p "$log_dir"
        echo "   ✓ Создан каталог журналов: $log_dir"
    fi
    chmod 755 "$log_dir" 2>/dev/null

    echo
    echo "1.5. Настройка системного logrotate..."
    
    local abs_log_path
    abs_log_path=$(readlink -f "${log_dir}/openvpn.log")

    cat << EOF | sudo tee "$logrotate_conf" >/dev/null
$abs_log_path {
    size 2M
    rotate 1
    copytruncate
    missingok
    notifempty
    su root root
}
EOF

    if [ $? -eq 0 ]; then
        sudo chmod 644 "$logrotate_conf" 2>/dev/null
        echo "   ✓ Применена конфигурация logrotate: $logrotate_conf"
    else
        echo "   ⚠️ Не удалось применить logrotate (проверьте права sudo)"
    fi

    echo
    echo "2. Настройка учетных данных (Логин/Пароль)"

    local current_user=""
    local current_pass=""

    if [ -f "$auth_file" ]; then
        current_user=$(sed -n '1p' "$auth_file")
        current_pass=$(sed -n '2p' "$auth_file")
        echo "   (Текущий пользователь: ${current_user:-Не задан})"
        echo "   * Нажмите Enter, чтобы сохранить текущее значение."
    fi

    echo
    read -rp "Логин [${current_user:-Не задан}]: " input_user
    read -s -rp "Пароль: " input_pass
    echo

    local final_user="${input_user:-$current_user}"
    local final_pass="${input_pass:-$current_pass}"

    if [ -z "$final_user" ] || [ -z "$final_pass" ]; then
        echo "Ошибка: Логин или пароль пустые. Сохранение отменено."
        return 1
    fi

    {
        echo "$final_user"
        echo "$final_pass"
    } > "$auth_file"

    chmod 600 "$auth_file"

    echo "✓ Учетные данные сохранены: $auth_file"
    echo "Первоначальная настройка успешно завершена."
    return 0
}

permission_cleanup() {
    local data_dir="${FVPN_DATA:-$HOME/VPN/FastestVPN/data}"
    local pid_file="$data_dir/fvpn.pid"
    local auth_file="$data_dir/auth.conf"
    local logrotate_conf="/etc/logrotate.d/fvpn"

    echo
    echo "=== Очистка и удаление ==="

    if [ "$DEBUG" = "1" ]; then
        echo "[DEBUG] PID_FILE = $pid_file"
        echo "[DEBUG] AUTH_FILE = $auth_file"
    fi

    local cleaned=0

    if [ -f "$pid_file" ]; then
        local pid
        pid=$(cat "$pid_file" 2>/dev/null)
        rm -f "$pid_file"
        echo "✓ Удален оставшийся файл PID (PID: ${pid:-Неизвестно})"
        cleaned=1
    fi

    if [ -f "$logrotate_conf" ]; then
        sudo rm -f "$logrotate_conf" 2>/dev/null
        echo "✓ Удален конфигурационный файл logrotate: $logrotate_conf"
        cleaned=1
    fi

    if [ "$cleaned" -eq 0 ]; then
        echo "✓ Оставшихся файлов для очистки не найдено."
    fi

    echo "Процедура очистки завершена."
    return 0
}

show_setup_cleanup_menu() {
    while true; do
        echo ""
        echo "========== Меню настройки и очистки =========="
        echo " 1) Первоначальная настройка (Права и Аутентификация)"
        echo " 2) Очистка и сброс прав"
        echo " 0) Назад (нажмите Enter)"
        echo "--------------------------------------------------------------"
        read -rp "Выберите [0]: " sc_choice
        sc_choice="${sc_choice:-0}"

        case "$sc_choice" in
            1) permission_setup ;;
            2) permission_cleanup ;;
            0) break ;;
            *) echo "Неверный выбор." ;;
        esac
    done
}

# ==============================================================================
# Main Menu Display
# ==============================================================================
show_main_menu() {
    while true; do
        show_debug_registers

        echo "========== FVPN v1.1.0 от Ton2Chan =========="
        echo " 1) Быстрое подключение VPN (к целевому серверу)"
        echo " 2) Отключить VPN"
        echo " 3) Выбрать сервер и подключиться"
        echo " 4) Настройки подключения (Режим, Протокол, Фильтр)"
        echo " 5) Управление серверами, рейтинги и обновления"
        echo " 9) Настройка и очистка (Права и Аутентификация)"
        echo " 0) Выход"
        echo "-------------------------------------------"
        show_status_header
        
        read -rp "Выберите вариант [0-9]: " choice

        case "$choice" in
            1) quick_connect ;;
            2) disconnect_vpn ;;
            3) select_vpn_server ;;
            4) show_quick_connect_settings ;;
            5) show_rating_menu ;;
            9) show_setup_cleanup_menu ;;
            0)
                exit_fvpn
                save_master_servers_buffer
                save_all_settings
                echo "Завершение работы FVPN."
                break
                ;;
            *) echo "❌ Неверный выбор." ;;
        esac

        echo ""
    done
}
