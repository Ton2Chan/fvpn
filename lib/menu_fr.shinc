#!/bin/bash
# ==============================================================================
# FVPN - Menu & User Interaction Module (French / Français)
# ==============================================================================

# ------------------------------------------------------------------------------
# Display Menu Footer / Status Header
# ------------------------------------------------------------------------------
show_status_header() {
    local phy_mode
    phy_mode=$(get_phy_mode)

    local m_tag="fix"
    case "${CONNECT_MODE}" in
        2|"2"|"SEQ")    m_tag="seq" ;;
        3|"3"|"RANDOM") m_tag="rnd" ;;
        1|"1"|"FIXED"|*) m_tag="fix" ;;
    esac

    # Format de colonne fixe
    local fix_str=" $m_tag "
    local lock_str=" lock "
    local state_str=" off "

    case "$phy_mode" in
        "CONNECTED")
            fix_str="[$m_tag]"
            ;;
        "LOCKDOWN")
            lock_str="[lock]"
            ;;
        "DISCONNECTED"|*)
            state_str="[off]"
            ;;
    esac

    # État d'authentification
    local auth_status="Authentification:[--]"
    local state="${AUTH_STATE:-0}"

    if [ "$state" -gt 0 ]; then
        auth_status="Authentification:[OK]"
    elif [ "$state" -lt 0 ]; then
        auth_status="Authentification:[NG]"
    else
        auth_status="Authentification:[--]"
    fi

    # Affichage de l'en-tête
    printf "VPN %s%s%s %s" "$fix_str" "$lock_str" "$state_str" "$auth_status"
    echo ""

    get_server_info_line

    echo ""
    echo "-------------------------------------------"
}

# ==============================================================================
# Connection Processing with UI Messages
# ==============================================================================

connect_by_master_index_wm() {
    local m_idx="$1"

    connect_by_master_index "$m_idx"
    local res=$?

    # --- Messages de résultat de connexion ---
    echo ""
    if [ "$res" -eq 0 ]; then
        echo " ✓ Connexion VPN établie avec succès."
    else
        echo " ❌ Échec de la connexion VPN."
        echo " 🔒 Trafic protégé par le Kill Switch (LOCKDOWN)"
    fi

    return $res
}

disconnect_vpn() {
    echo "Déconnexion du VPN en cours..."

    if phy_disconnect; then
        phy_cleanup_if_disconnected
        echo "✓ Connexion directe IP restaurée."
        return 0
    else
        echo "❌ Échec de l'arrêt du processus physique."
        return 1
    fi
}

exit_fvpn() {
    local current_mode
    current_mode=$(get_phy_mode)

    if [ "$current_mode" != "DISCONNECTED" ]; then
        echo ""
        echo "⚠️  Le VPN est actuellement connecté (ou le trafic est bloqué)."
        read -rp "Déconnecter le VPN et quitter ? [y/N]: " ans

        case "$ans" in
            [yY]|[yY][eE][sS]|[oO]|[oO][uU][iI])
                disconnect_vpn
                ;;
            *)
                echo "Maintien de l'état de protection VPN (Kill Switch)."
                ;;
        esac
    else
        phy_cleanup_if_disconnected
    fi
}

# ==============================================================================
# Quick Connection Settings UI & Submenu Functions
# ==============================================================================

configure_connect_mode() {
    local m_opt
    echo
    echo "1: Accès Fixe (Toujours se connecter au serveur cible sélectionné)"
    echo "2: Accès Séquentiel (Passer au serveur suivant à chaque connexion)"
    echo "3: Accès Aléatoire (Sélection automatique parmi les candidats filtrés)"
    read -rp "Sélectionnez le mode [1-3]: " m_opt
    case "$m_opt" in
        1|2|3)
            CONNECT_MODE="$m_opt"
            ;;
    esac
}

configure_protocol_mode() {
    local p_opt
    echo
    echo "1: UDP uniquement (Rapide / Recommandé)"
    echo "2: TCP uniquement (Axé sur la stabilité)"
    echo "3: Mixte (Sélectionner UDP et TCP)"
    read -rp "Sélectionnez le protocole [1-3]: " p_opt
    case "$p_opt" in
        1) set_protocol_mode 1 ;;
        2) set_protocol_mode -1 ;;
        3) set_protocol_mode 0 ;;
        *) return ;;
    esac

    build_active_servers
    sync_target_index_by_server
}

configure_filter_level() {
    local f_val
    echo
    echo "--- Sélectionner le niveau de filtre de connexion ---"
    echo " 4)  [4] 3  2  1  0  : Évaluation 4 uniquement (Favoris)"
    echo " 3)  [4  3] 2  1  0  : Évaluation 3 (Bon) ou supérieure"
    echo " 2)  [4  3  2] 1  0  : Évaluation 2 (Standard) ou supérieure"
    echo " 1)  [4  3  2  1] 0  : Évaluation 1 (Passable) ou supérieure"
    echo " 0)  [4  3  2  1  0] : Sélectionner tous les serveurs"
    echo "---------------------------------------------------"
    read -rp "Sélectionnez le niveau [0-4 / Entrée pour revenir]: " f_val
    if [ -n "$f_val" ] && [[ "$f_val" =~ ^[0-4]$ ]]; then
        FILTER_LEVEL="$f_val"
        build_active_servers
        sync_target_index_by_server
    fi
}

update_servers() {
    local mode="${1:-force}"
    local base_dir="${FVPN_HOME:-.}"
    local data_dir="${FVPN_DATA:-${base_dir}/data}"
    local work_zip="${data_dir}/fastestvpn_ovpn.zip"

    local dl_dir
    dl_dir=$(get_download_dir)
    local local_zip="${dl_dir}/fastestvpn_ovpn.zip"
    local local_bak="${dl_dir}/fastestvpn_ovpn.zip.bak"

    if [ "$HAS_UPDATE_ZIP" -eq 1 ]; then
        mkdir -p "$data_dir"
        cp -f "$local_zip" "$work_zip"
        mv -f "$local_zip" "$local_bak"
        HAS_UPDATE_ZIP=0
    else
        if ! is_network_online || [ "$(get_phy_mode)" = "LOCKDOWN" ]; then
            echo "Impossible de se connecter au réseau."
            return 1
        fi

        if [ "$mode" = "skip" ]; then
            CURRENT_TIMEOUT="${TIMEOUT_AUTO_UPDATE}"
            if ! should_check_update; then
                return 0
            fi
        else
            CURRENT_TIMEOUT="${TIMEOUT_MANUAL_UPDATE}"
        fi

        local target_url="${CUSTOM_UPDATE_URL:-$OFFICIAL_UPDATE_URL}"

        if ! download_url_to_work_zip "$target_url" "$work_zip"; then
            echo "⚠️ Échec du téléchargement du fichier de mise à jour."
            return 1
        fi
    fi

    if ! apply_work_zip_package; then
        echo "⚠️ Échec de l'application du paquet de mise à jour."
        return 1
    fi

    local default_mark="${MARK_ADDED:-+}"
    if [ "${FVPN_TOTAL_COUNT}" -eq 0 ]; then
        default_mark="${MARK_NORMAL:-_}"
    fi

    build_master_servers "$default_mark"

    echo "✓ Liste des serveurs mise à jour avec succès."
    return 0
}

# ==============================================================================
# Export Rating Data
# ==============================================================================
export_server_ratings() {
    local target_dir
    target_dir=$(get_download_dir)

    if [ ! -d "$target_dir" ]; then
        mkdir -p "$target_dir" 2>/dev/null || {
            echo "Erreur : Échec de la création du répertoire cible ($target_dir)."
            return 1
        }
    fi

    if [ -z "$MASTER_SERVERS_BUFFER" ]; then
        echo "Erreur : Aucune donnée de serveur disponible pour l'exportation."
        return 1
    fi

    local export_file="${target_dir}/${FILE_RATINGS_EXPORT_NAME:-fvpn_ratings.txt}"
    local tmp_file
    tmp_file=$(mktemp)

    local buf_len=${#MASTER_SERVERS_BUFFER}
    local offset=0
    local exported_count=0

    while [ "$offset" -lt "$buf_len" ]; do
        local rec="${MASTER_SERVERS_BUFFER:$offset:RECORD_BYTE_SIZE}"
        [ ${#rec} -lt 120 ] && break

        local line="${rec%$'\n'}"
        line="${line%"${line##*[![:space:]]}"}"

        if [ -n "$line" ]; then
            printf "%s\n" "$line" >> "$tmp_file"
            ((exported_count++))
        fi

        offset=$((offset + RECORD_BYTE_SIZE))
    done

    if [ "$exported_count" -gt 0 ]; then
        mv "$tmp_file" "$export_file"
        echo "✓ Exportation de ${exported_count} enregistrements d'évaluation réussie."
        echo "  Emplacement de sortie : ${export_file}"
    else
        rm -f "$tmp_file"
        echo "Erreur : Aucune donnée disponible pour l'exportation."
    fi

    return 0
}

# ==============================================================================
# Import Rating Data
# ==============================================================================
import_server_ratings() {
    local target_dir
    target_dir=$(get_download_dir)

    local import_file="${target_dir}/${FILE_RATINGS_EXPORT_NAME:-fvpn_ratings.txt}"

    if [ ! -f "$import_file" ]; then
        echo "Erreur : Fichier d'importation introuvable."
        echo "  Chemin vérifié : ${import_file}"
        return 1
    fi

    if [ -z "$MASTER_SERVERS_BUFFER" ]; then
        build_master_servers
    fi

    echo "Importation des données d'évaluation des serveurs..."

    declare -A import_map
    local loaded_count=0
    local line

    while IFS= read -r line || [ -n "$line" ]; do
        [ ${#line} -lt 14 ] && continue

        local p_type="${line:${OFFSET_PROTO}:${LENGTH_PROTO}}"
        local r_val="${line:${OFFSET_RATING}:${LENGTH_RATING}}"
        local fn="${line:${OFFSET_FNAME}}"
        fn=$(echo "$fn" | xargs)

        if [[ "$p_type" =~ ^[ut]$ ]] && [[ "$r_val" =~ ^[0-4]$ ]] && [ -n "$fn" ]; then
            import_map["${p_type}_${fn}"]="$r_val"
            ((loaded_count++))
        fi
    done < "$import_file"

    if [ "$loaded_count" -eq 0 ]; then
        echo "Avertissement : Aucune donnée valide trouvée dans le fichier d'importation."
        return 1
    fi

    local rec_size=${RECORD_BYTE_SIZE}
    local buf_len=${#MASTER_SERVERS_BUFFER}
    local offset=0
    local updated_count=0

    while [ "$offset" -lt "$buf_len" ]; do
        local rec="${MASTER_SERVERS_BUFFER:$offset:$rec_size}"
        [ ${#rec} -lt 120 ] && break

        local p_type="${rec:${OFFSET_PROTO}:${LENGTH_PROTO}}"
        local fn="${rec:${OFFSET_FNAME}}"
        fn=$(echo "$fn" | xargs)

        local key="${p_type}_${fn}"

        if [ -n "${import_map[$key]+exists}" ]; then
            local new_r="${import_map[$key]}"
            local current_r="${rec:${OFFSET_RATING}:${LENGTH_RATING}}"

            if [ "$current_r" != "$new_r" ]; then
                local target_idx=$((offset + ${OFFSET_RATING}))
                MASTER_SERVERS_BUFFER="${MASTER_SERVERS_BUFFER:0:$target_idx}${new_r}${MASTER_SERVERS_BUFFER:$((target_idx + 1))}"
                ((updated_count++))
            fi
        fi

        offset=$((offset + rec_size))
    done

    if [ "$updated_count" -gt 0 ]; then
        build_active_servers
        sync_target_index_by_server
        echo "✓ Importation de ${updated_count} enregistrements d'évaluation réussie."
    else
        echo "Info : Aucune modification trouvée dans les données."
    fi

    return 0
}

# ==============================================================================
# Quick Connection Logic
# ==============================================================================

quick_connect() {
    local N="${ACTIVE_TOTAL_COUNT}"

    if [ "$N" -le 0 ]; then
        echo "❌ Aucun serveur disponible n'a passé le filtre de connexion."
        return 1
    fi

    case "${CONNECT_MODE}" in
        2)
            TARGET_INDEX=$(( (TARGET_INDEX + 1) % N ))
            ;;
        3)
            local r=$(( RANDOM % N ))
            [ "$r" -eq "$TARGET_INDEX" ] && r=$(( (r + 1) % N ))
            TARGET_INDEX="$r"
            ;;
        1|*)
            (( TARGET_INDEX < 0 )) && TARGET_INDEX=0
            ;;
    esac
    update_target_server_by_index

    local m_idx
    m_idx=$(get_target_master_index)

    local display_info
    display_info=$(get_server_info_line "$TARGET_INDEX")
    echo "${display_info}"

    connect_by_master_index_wm "$m_idx"
    return $?
}

show_quick_connect_settings() {
    while true; do
        local mode_disp proto_disp filter_disp

        case "${CONNECT_MODE}" in
            1) mode_disp="[1:FIXE] 2:SÉQ  3:ALÉATOIRE" ;;
            2) mode_disp=" 1:FIXE [2:SÉQ] 3:ALÉATOIRE" ;;
            3) mode_disp=" 1:FIXE  2:SÉQ [3:ALÉATOIRE]" ;;
            *) mode_disp="[1:FIXE] 2:SÉQ  3:ALÉATOIRE" ;;
        esac

        local p="${PROTOCOL_MODE}"
        if (( p > 0 )); then
            proto_disp="[1:UDP]  2:TCP  3:MIXTE"
        elif (( p < 0 )); then
            proto_disp="1:UDP  [2:TCP]  3:MIXTE"
        else
            proto_disp="1:UDP  2:TCP  [3:MIXTE]"
        fi

        case "${FILTER_LEVEL}" in
            4) filter_disp="[4] 3  2  1  0" ;;
            3) filter_disp="[4  3] 2  1  0" ;;
            2) filter_disp="[4  3  2] 1  0" ;;
            1) filter_disp="[4  3  2  1] 0" ;;
            0) filter_disp="[4  3  2  1  0]" ;;
            *) filter_disp="[4  3  2] 1  0" ;;
        esac

        echo
        echo "========== Paramètres de Connexion Rapide =========="
        echo " 1) Changer le mode de connexion  : ${mode_disp}"
        echo " 2) Changer le mode de protocole : ${proto_disp}"
        echo " 3) Niveau de filtre             : ${filter_disp}"
        echo " 0) Retour (Appuyez sur Entrée pour revenir)"
        echo "----------------------------------------------------"
        read -p "Sélectionnez l'option [0]: " q_choice
        q_choice="${q_choice:-0}"

        case "$q_choice" in
            1) configure_connect_mode ;;
            2) configure_protocol_mode ;;
            3) configure_filter_level ;;
            0) break ;;
            *) echo "Option invalide." ;;
        esac
    done
}

# ==============================================================================
# Server Management & Rating UI
# ==============================================================================

reset_ratings_menu() {
    echo ""
    read -p "Réinitialiser toutes les évaluations à la valeur par défaut (2) ? (y/N): " confirm
    case "$confirm" in
        [yY]|[yY][eE][sS]|[oO]|[oO][uU][iI])
            if reset_server_ratings; then
                echo "✓ Opération terminée. (Niveau de filtre réinitialisé à 0)"
            fi
            ;;
        *)
            echo "Opération annulée."
            ;;
    esac
}

manage_protocol_servers() {
    local target_proto="$1"
    local proto_label="UDP"
    [ "$target_proto" = "t" ] && proto_label="TCP"

    local record_size=${RECORD_BYTE_SIZE}
    local udp_cnt="${FVPN_UDP_COUNT}"
    local tcp_cnt="${FVPN_TCP_COUNT}"

    local max_num=$udp_cnt
    if [ "$target_proto" = "t" ]; then
        max_num=$tcp_cnt
    fi

    [ "$max_num" -le 0 ] && { echo "(Aucun serveur ${proto_label} correspondant trouvé)"; return 0; }

    echo ""
    echo "========== Liste des Serveurs ${proto_label} et Paramètres =========="
    
    local base_index
    base_index=$(get_master_index "$target_proto" 1)
    local start_byte=$(( base_index * record_size ))
    local total_bytes=$(( max_num * record_size ))
    local sub_buf="${MASTER_SERVERS_BUFFER:$start_byte:$total_bytes}"

    printf '%s' "$sub_buf" | sed 's/[[:space:]]*$//'

    echo "=================================================="
    echo " Légende : 4:Favori, 2:Non évalué, 1:Passable, 3:Bon, 0:Exclu"
    echo "--------------------------------------------------"

    while true; do
        read -rp "Sélectionnez le numéro du serveur à modifier [Entrée ou 0 pour revenir]: " num_input

        [ -z "$num_input" ] || [ "$num_input" = "0" ] && break

        if [[ ! "$num_input" =~ ^[1-9][0-9]*$ ]] || [ "$num_input" -gt "$max_num" ]; then
            echo "⚠️ Veuillez entrer un nombre entre 1 et ${max_num}."
            continue
        fi

        local target_master_idx
        target_master_idx=$(get_master_index "$target_proto" "$num_input")

        echo "$(get_master_server_info_line "$target_master_idx")"
        read -rp "Entrez la nouvelle évaluation [0-4]: " new_rate
        if [[ ! "$new_rate" =~ ^[0-4]$ ]]; then
            echo "⚠️ Veuillez entrer une valeur entre 0 et 4."
            continue
        fi

        update_server_rating_by_master_index "$target_master_idx" "$new_rate"
        echo "$(get_master_server_info_line "$target_master_idx")"
        echo ""
    done
}

select_vpn_server() {
    local target_proto=""

    while true; do
        echo -e "\n========== Sélection Directe du Serveur et Connexion =========="
        echo " 1) UDP"
        echo " 2) TCP"
        echo " 0) Retour (Appuyez sur Entrée pour revenir)"
        read -rp "Sélectionnez [0-2]: " p_choice

        case "$p_choice" in
            1) target_proto="u"; break ;;
            2) target_proto="t"; break ;;
            0|"") echo "Opération annulée."; return 0 ;;
            *) echo "⚠️ Option invalide. Entrez une valeur entre 0 et 2." ;;
        esac
    done

    local target_count=0
    if [ "$target_proto" = "u" ]; then
        target_count="${ACTIVE_UDP_COUNT}"
    else
        target_count="${ACTIVE_TCP_COUNT}"
    fi

    if [ "$target_count" -le 0 ]; then
        echo "⚠️ Aucun serveur n'a passé le filtre pour le protocole sélectionné (${target_proto^^})."
        return 0
    fi

    echo ""
    echo "--- Liste des Serveurs Disponibles (${target_proto^^} : ${target_count} éléments) ---"

    local start_offset=0
    [ "$target_proto" = "t" ] && start_offset=$(( ${ACTIVE_UDP_COUNT} * RECORD_BYTE_SIZE ))
    local total_bytes=$(( target_count * RECORD_BYTE_SIZE ))

    local sub_buf="${ACTIVE_SERVERS_BUFFER:$start_offset:$total_bytes}"
    printf '%s\n' "$sub_buf" | sed 's/[[:space:]]*$//'

    local match_target_index=-1
    local target_master_idx=-1
    local s_num=""

    while true; do
        read -rp "Entrez le numéro du serveur auquel vous connecter (0 pour revenir): " s_num

        if [ -z "$s_num" ] || [ "$s_num" -eq 0 ] 2>/dev/null; then
            echo "Opération annulée."
            return 0
        fi

        if ! [[ "$s_num" =~ ^[1-9][0-9]*$ ]]; then
            echo "⚠️ Saisie invalide. Veuillez entrer un nombre valide."
            continue
        fi

        match_target_index=-1
        target_master_idx=-1
        local i=0

        while [ "$i" -lt "$target_count" ]; do
            local current_offset=$(( start_offset + (i * RECORD_BYTE_SIZE) ))
            local rec="${ACTIVE_SERVERS_BUFFER:$current_offset:RECORD_BYTE_SIZE}"

            local num_str="${rec:$OFFSET_INDEX:$LENGTH_INDEX}"
            num_str=$(echo "$num_str" | xargs)

            if [ "$num_str" -eq "$s_num" ] 2>/dev/null; then
                if [ "$target_proto" = "u" ]; then
                    match_target_index="$i"
                else
                    match_target_index=$(( ${ACTIVE_UDP_COUNT} + i ))
                fi

                local p_type="${rec:$OFFSET_PROTO:$LENGTH_PROTO}"
                target_master_idx=$(get_master_index "$p_type" "$num_str")
                break
            fi
            ((i++))
        done

        if [ "$target_master_idx" -ge 0 ]; then
            break
        fi

        echo "⚠️ Le serveur numéro [ ${s_num} ] n'est pas disponible dans la liste filtrée ${target_proto^^}."
    done

    TARGET_INDEX="$match_target_index"
    update_target_server_by_index

    get_server_info_line
    echo ""
    connect_by_master_index_wm "$target_master_idx"
    return $?
}

show_rating_menu() {
    while true; do
        echo ""
        echo "========== Menu de Gestion des Serveurs =========="
        echo " 1) Liste des Serveurs UDP et Évaluation"
        echo " 2) Liste des Serveurs TCP et Évaluation"
        echo " 3) Exporter les Évaluations des Serveurs"
        echo " 4) Importer les Évaluations des Serveurs"
        echo " 5) Réinitialiser Toutes les Évaluations"
        echo " 6) Mettre à Jour la Liste des Serveurs"
        echo " 7) Configurer le Délai d'Attente (Timeout) de Connexion VPN"
        echo " 0) Retour (Appuyez sur Entrée pour revenir)"
        echo "--------------------------------------------------------"
        read -rp "Sélectionnez [0]: " rm_choice
        rm_choice="${rm_choice:-0}"

        case "$rm_choice" in
            1) manage_protocol_servers "u" ;;
            2) manage_protocol_servers "t" ;;
            3) export_server_ratings ;;
            4) import_server_ratings ;;
            5) reset_ratings_menu ;;
            6) update_servers ;;
            7) configure_vpn_timeout ;;
            0) break ;;
            *) echo "Option invalide." ;;
        esac
    done
}

configure_vpn_timeout() {
    local t_val
    echo
    echo "--- Configurer le Délai d'Attente (Timeout) de Connexion VPN ---"
    echo " Valeur actuelle : ${TIMEOUT_VPN_CONNECT} secondes"
    read -rp "Entrez le nouveau délai en secondes [1-120 / Entrée pour revenir]: " t_val
    if [[ "$t_val" =~ ^[0-9]+$ ]] && [ "$t_val" -ge 1 ] && [ "$t_val" -le 120 ]; then
        TIMEOUT_VPN_CONNECT="$t_val"
        save_all_settings
        echo "✓ Délai de connexion configuré à ${TIMEOUT_VPN_CONNECT} secondes."
    fi
}

permission_setup() {
    local data_dir="${FVPN_DATA:-$HOME/VPN/FastestVPN/data}"
    local log_dir="${FVPN_LOGDIR:-$HOME/VPN/FastestVPN/logs}"
    local auth_file="$data_dir/auth.conf"
    local logrotate_conf="/etc/logrotate.d/fvpn"

    echo
    echo "=== Configuration Initiale (Autorisations et Authentification) ==="

    if [ "$DEBUG" = "1" ]; then
        echo "[DEBUG] FVPN_DATA = $data_dir"
        echo "[DEBUG] FVPN_LOGDIR = $log_dir"
        echo "[DEBUG] AUTH_FILE = $auth_file"
    fi

    echo "1. Configuration des répertoires et des autorisations..."
    if [ ! -d "$data_dir" ]; then
        mkdir -p "$data_dir"
        echo "   ✓ Répertoire de données créé : $data_dir"
    fi
    chmod 700 "$data_dir" 2>/dev/null

    if [ ! -d "$log_dir" ]; then
        mkdir -p "$log_dir"
        echo "   ✓ Répertoire de journaux (logs) créé : $log_dir"
    fi
    chmod 755 "$log_dir" 2>/dev/null

    echo
    echo "1.5. Configuration du logrotate système..."
    
    local abs_log_path
    abs_log_path=$(readlink -f "${log_dir}/openvpn.log")

    cat << EOF | sudo tee "$logrotate_conf" >/dev/null
$abs_log_path {
    size 2M
    rotate 1
    copytruncate
    missingok
    notifempty
    su root root
}
EOF

    if [ $? -eq 0 ]; then
        sudo chmod 644 "$logrotate_conf" 2>/dev/null
        echo "   ✓ Configuration de logrotate appliquée : $logrotate_conf"
    else
        echo "   ⚠️ Échec de l'application de logrotate (vérifiez les autorisations sudo)"
    fi

    echo
    echo "2. Configurer les Identifiants d'Authentification (Identifiant/Mot de passe)"

    local current_user=""
    local current_pass=""

    if [ -f "$auth_file" ]; then
        current_user=$(sed -n '1p' "$auth_file")
        current_pass=$(sed -n '2p' "$auth_file")
        echo "   (Utilisateur actuel : ${current_user:-Non défini})"
        echo "   * Appuyez sur Entrée pour conserver les valeurs existantes."
    fi

    echo
    read -rp "Nom d'utilisateur [${current_user:-Non défini}]: " input_user
    read -s -rp "Mot de passe : " input_pass
    echo

    local final_user="${input_user:-$current_user}"
    local final_pass="${input_pass:-$current_pass}"

    if [ -z "$final_user" ] || [ -z "$final_pass" ]; then
        echo "Erreur : Nom d'utilisateur ou mot de passe vide. Enregistrement annulé."
        return 1
    fi

    {
        echo "$final_user"
        echo "$final_pass"
    } > "$auth_file"

    chmod 600 "$auth_file"

    echo "✓ Identifiants enregistrés : $auth_file"
    echo "Configuration initiale terminée avec succès."
    return 0
}

permission_cleanup() {
    local data_dir="${FVPN_DATA:-$HOME/VPN/FastestVPN/data}"
    local pid_file="$data_dir/fvpn.pid"
    local auth_file="$data_dir/auth.conf"
    local logrotate_conf="/etc/logrotate.d/fvpn"

    echo
    echo "=== Procédure de Nettoyage et Désinstallation ==="

    if [ "$DEBUG" = "1" ]; then
        echo "[DEBUG] PID_FILE = $pid_file"
        echo "[DEBUG] AUTH_FILE = $auth_file"
    fi

    local cleaned=0

    if [ -f "$pid_file" ]; then
        local pid
        pid=$(cat "$pid_file" 2>/dev/null)
        rm -f "$pid_file"
        echo "✓ Fichier PID résiduel supprimé (PID : ${pid:-Inconnu})"
        cleaned=1
    fi

    if [ -f "$logrotate_conf" ]; then
        sudo rm -f "$logrotate_conf" 2>/dev/null
        echo "✓ Fichier de configuration logrotate supprimé : $logrotate_conf"
        cleaned=1
    fi

    if [ "$cleaned" -eq 0 ]; then
        echo "✓ Aucun fichier résiduel à nettoyer."
    fi

    echo "Procédure de nettoyage terminée."
    return 0
}

show_setup_cleanup_menu() {
    while true; do
        echo ""
        echo "========== Configuration d'Initialisation et Nettoyage =========="
        echo " 1) Configuration Initiale (Autorisations et Authentification)"
        echo " 2) Nettoyage et Suppression des Autorisations"
        echo " 0) Retour (Appuyez sur Entrée pour revenir)"
        echo "--------------------------------------------------------------"
        read -rp "Sélectionnez [0]: " sc_choice
        sc_choice="${sc_choice:-0}"

        case "$sc_choice" in
            1) permission_setup ;;
            2) permission_cleanup ;;
            0) break ;;
            *) echo "Option invalide." ;;
        esac
    done
}

# ==============================================================================
# Main Menu Display
# ==============================================================================
show_main_menu() {
    while true; do
        show_debug_registers

        echo "========== FVPN v1.1.0 par Ton2Chan =========="
        echo " 1) Connexion Rapide VPN (Se connecter au serveur cible)"
        echo " 2) Déconnecter le VPN"
        echo " 3) Sélectionner un Serveur et se Connecter"
        echo " 4) Paramètres de Connexion (Mode, Protocole, Filtre)"
        echo " 5) Gestion des Serveurs, Évaluation et Mises à jour"
        echo " 9) Initialisation et Nettoyage (Autorisations et Authentification)"
        echo " 0) Quitter"
        echo "-------------------------------------------"
        show_status_header
        
        read -rp "Veuillez sélectionner [0-9]: " choice

        case "$choice" in
            1) quick_connect ;;
            2) disconnect_vpn ;;
            3) select_vpn_server ;;
            4) show_quick_connect_settings ;;
            5) show_rating_menu ;;
            9) show_setup_cleanup_menu ;;
            0)
                exit_fvpn
                save_master_servers_buffer
                save_all_settings
                echo "Fermeture de FVPN."
                break
                ;;
            *) echo "❌ Option invalide." ;;
        esac

        echo ""
    done
}

