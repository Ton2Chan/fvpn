#!/bin/bash
# ==============================================================================
# FVPN - Main Executable Entrypoint
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

# Source only official .sh files directly under the lib directory
for f in ./lib/*.sh; do
    [ -f "$f" ] || continue
    [[ "$f" =~ \( ]] && continue
    source "$f"
done

# ------------------------------------------------------------------------------
# Startup System Initialization & Main Menu Execution
# ------------------------------------------------------------------------------

# 1. Setup physical layer
_phy_boot

# 2. Set new status determination flags and display trap messages
init_boot_process

# 3. Invoke main menu
show_main_menu "$@"
