#!/bin/bash
# ==============================================================================
# FVPN - Main Executable Entrypoint
# メイン実行エントリーポイント
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

# ------------------------------------------------------------------------------
# 1. Load Core Libraries (*.sh only)
# コアライブラリの読み込み (lib ディレクトリ直下の正規 .sh のみ)
# ------------------------------------------------------------------------------
for f in ./lib/*.sh; do
    [ -f "$f" ] || continue
    [[ "$f" =~ \( ]] && continue
    source "$f"
done

# ------------------------------------------------------------------------------
# 2. Language Switch & Auto-Detection
# 言語の自動取得・切り替え処理
# ------------------------------------------------------------------------------
# Supported / Planned ISO 639-1 Language Codes:
# en (English), ja (Japanese), pt (Portuguese), zh (Chinese), de (German),
# fr (French), es (Spanish), hi (Hindi), ko (Korean), ru (Russian), etc.
#
# Examples:
#   ./fvpn --lang=pt  (Portuguese)
#   ./fvpn --lang=ja  (Japanese)
#   ./fvpn --lang=en  (English)

# A) 隠しコマンド引数 (--lang=xx) の解析
for arg in "$@"; do
    case "$arg" in
        --lang=*)
            FVPN_LANG="${arg#*=}"
            ;;
    esac
done

# B) FVPN_LANG が未指定の場合、OS のシステム言語 (LANG) から自動取得 (例: "ja_JP.UTF-8" -> "ja")
if [ -z "$FVPN_LANG" ]; then
    sys_lang="${LANG:-en}"
    FVPN_LANG="${sys_lang%%_*}"
    FVPN_LANG="${FVPN_LANG%%.*}"
fi

# C) それでも空の場合はデフォルト値 'en' をセット
FVPN_LANG="${FVPN_LANG:-en}"

# ------------------------------------------------------------------------------
# 3. Dynamic Language Resource Loader (lang/*.shinc) with Mandatory English Fallback
# 言語リソースの動的ロード (英語ベースのフォールバック + ターゲット言語の動的上書き)
# ------------------------------------------------------------------------------
LANG_DIR="./lang"
BASE_LANG_FILE="${LANG_DIR}/en.shinc"
TARGET_LANG_FILE="${LANG_DIR}/${FVPN_LANG}.shinc"

# 1. Load English base resource first (Ensures missing translation keys fallback to English seamlessly)
# 1. ベースとなる英語リソースを最初にロード (辞書キーの未定義エラーを安全に防止)
if [ -f "$BASE_LANG_FILE" ]; then
    source "$BASE_LANG_FILE"
else
    echo "[ERROR] Base language resource (lang/en.shinc) not found." >&2
    exit 1
fi

# 2. Dynamic Override: Load requested language resource if it exists (No code modification needed for new languages!)
# 2. 動的上書き: ターゲット言語ファイルが存在すれば上書きロード (新言語ファイルを配置するだけで即座に対応可能)
if [ "$FVPN_LANG" != "en" ] && [ -f "$TARGET_LANG_FILE" ]; then
    source "$TARGET_LANG_FILE"
fi

# ------------------------------------------------------------------------------
# 4. System Initialization & Main Menu Execution
# 起動時システム初期化 ＆ メインメニュー実行
# ------------------------------------------------------------------------------

# Setup physical network components
# 物理層のお膳立て
_phy_boot

# Initialize status flags and trap displays
# 状態判定フラグのセットとトラップ表示
init_boot_process

# Launch main menu
# メインメニューの呼び出し
show_main_menu "$@"
